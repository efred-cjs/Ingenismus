# Backend Flask -> Firebase Realtime Database
FIREBASE_DATABASE_URL=https://<tu-proyecto>-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_FILE=backend/serviceAccountKey.json
HTTP_PORT=5000

# Proxy del frontend (debe apuntar al puerto HTTP_PORT del backend)
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
